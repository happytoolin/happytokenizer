---
import { ChatTokenizer } from "../components/react/ChatTokenizer";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/MainLayout.astro";

const pageSchema = [
  {
    "@type": "SoftwareApplication",
    name: "HappyTokenizer Chat Tokenizer",
    url: "https://happytokenizer.com/chat",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web Browser",
    description:
      "Tokenize and analyze multi-turn AI chat conversations with role-aware context formatting.",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "How does chat token counting differ from plain text token counting?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Chat token counting includes role and message formatting tokens that are added by chat APIs, so totals differ from plain text estimates.",
        },
      },
      {
        "@type": "Question",
        name: "Can I model a full conversation before sending it to an API?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. You can build multi-message prompts in the chat editor and inspect token totals before calling production endpoints.",
        },
      },
    ],
  },
];
---

<Layout
  title="Chat Tokenizer - HappyTokenizer"
  description="Analyze token usage in chat conversations with multi-turn message support. See how GPT models process conversational context and understand token costs for AI chat applications."
  keywords="chat tokenizer, ai chat token counter, openai chat token calculator, prompt token budget"
  schema={pageSchema}
>
  <div class="min-h-screen w-full relative overflow-hidden bg-brand-paper">
    <div class="relative z-10 max-w-[1400px] mx-auto p-4 md:p-8 lg:p-12 flex flex-col gap-8">
      <header class="flex flex-col gap-6">
        <Navbar currentPage="tokenizer" />
        <div class="bg-white border-2 border-brand-black p-5 md:p-6">
          <h1 class="font-display text-3xl md:text-4xl font-black uppercase mb-3">
            Chat Tokenizer
          </h1>
          <p class="font-body text-base md:text-lg leading-relaxed text-brand-black max-w-4xl">
            Estimate chat prompt tokens with role-aware formatting for system,
            user, assistant, and tool messages. Use this page to simulate full
            conversations and optimize context windows before sending requests.
          </p>
        </div>
      </header>

      <section aria-label="Chat tokenizer workspace">
        <ChatTokenizer client:visible />
      </section>

      <section class="bg-white border-2 border-brand-black p-6 md:p-8 flex flex-col gap-4">
        <h2 class="font-display text-2xl md:text-3xl font-bold uppercase">
          Why Use The Chat Tokenizer?
        </h2>
        <ul class="font-body text-base text-brand-black leading-relaxed list-disc pl-5 space-y-2">
          <li>Model complete conversations before hitting token limits.</li>
          <li>Compare how different models price the same chat history.</li>
          <li>Tune system prompts and message counts for lower latency and cost.</li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
