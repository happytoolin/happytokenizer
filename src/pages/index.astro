---
import Navbar from "../components/Navbar.astro";
import { TokenizerApp } from "../components/react/TokenizerApp";
import MainLayout from "../layouts/MainLayout.astro";

const pageSchema = [
  {
    "@type": "SoftwareApplication",
    name: "HappyTokenizer",
    url: "https://happytokenizer.com",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web Browser",
    description:
      "Interactive tokenizer and token cost calculator for GPT, Claude, Kimi, Qwen, and GLM model families.",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    featureList: [
      "Real-time token counting",
      "Model-specific tokenizer selection",
      "Token cost estimation",
      "Client-side processing",
    ],
  },
  {
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is HappyTokenizer used for?",
        acceptedAnswer: {
          "@type": "Answer",
        text: "HappyTokenizer helps developers analyze how text is split into tokens for different GPT, Claude, Kimi, Qwen, and GLM encodings, and estimate cost impact per model.",
        },
      },
      {
        "@type": "Question",
        name: "Does HappyTokenizer send my text to a server?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "No. Tokenization runs client-side in your browser, so your input stays local while you inspect token usage.",
        },
      },
      {
        "@type": "Question",
        name: "Can I compare multiple model families?",
        acceptedAnswer: {
          "@type": "Answer",
        text: "Yes. You can switch between OpenAI, Anthropic, Moonshot, Alibaba, and Z.ai model families to compare token counts and pricing behavior.",
        },
      },
    ],
  },
];
---

  <MainLayout
    title="Free Online Tokenizer — GPT, Claude, Kimi, Qwen & GLM | HappyTokenizer"
    description="Count tokens instantly in your browser for GPT, Claude, Kimi, Qwen and GLM models. Compare token counts, context limits and API pricing — free, no signup, 100% private."
  keywords="tokenizer, gpt tokenizer, token counter, token calculator, online tokenizer, openai tokenizer, claude tokenizer, qwen tokenizer, glm tokenizer, kimi tokenizer, llm tokenization, free token counter"
    schema={pageSchema}
  >
  <style
    define:vars={{
      "c-orange": "#ff6600",
      "c-black": "#1a1a1a",
      "c-paper": "#f2f2f0",
    }}
  >
    .happytokenizer-grid {
      background-image:
        linear-gradient(var(--c-black) 1px, transparent 1px),
        linear-gradient(90deg, var(--c-black) 1px, transparent 1px);
      background-size: 40px 40px;
      background-position: -1px -1px;
      mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    }
  </style>

  <div class="min-h-screen w-full relative overflow-hidden bg-(--c-paper)">
    <!-- Background Grid -->
    <div
      class="absolute inset-0 opacity-[0.03] happytokenizer-grid pointer-events-none z-0"
    >
    </div>

    <div
      class="relative z-10 max-w-[1400px] mx-auto p-4 md:p-8 lg:p-12 flex flex-col gap-8"
    >
      <!-- NAVBAR SECTION -->
      <header class="flex flex-col gap-6">
        <Navbar currentPage="tokenizer" />
        <div class="relative bg-white border-2 border-brand-black p-5 md:p-6">
          <div
            class="absolute -top-3 right-4 rotate-2 bg-brand-orange text-white font-mono text-xs font-bold px-3 py-1.5 border border-black shadow-[3px_3px_0px_#1a1a1a] flex items-center gap-1.5"
            role="note"
            aria-label="Fastest in-browser tokenizer"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
            </svg>
            FASTEST
          </div>
          <p class="font-mono text-xs uppercase tracking-wider text-brand-orange mb-3">
            OpenAI &middot; Anthropic &middot; Moonshot &middot; Alibaba &middot; Z.ai
          </p>
          <h1
            class="font-display text-3xl md:text-4xl font-black uppercase mb-3"
          >
            LLM Tokenizer And Token Cost Calculator
          </h1>
          <p
            class="font-body text-base md:text-lg leading-relaxed text-brand-black max-w-4xl"
          >
            Inspect token boundaries, context impact, and pricing across GPT,
            Claude, Kimi, Qwen, and GLM model families in a browser-based
            tokenizer.
          </p>
          <div class="flex flex-wrap gap-2 mt-4">
            {
              [
                "Instant results as you type",
                "100% private — never leaves your browser",
                "Handles 1M+ token prompts",
              ].map((label) => (
                <span class="inline-flex items-center gap-1.5 border border-brand-black bg-white px-2 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider">
                  <svg
                    class="w-3 h-3 text-brand-orange"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
                  </svg>
                  {label}
                </span>
              ))
            }
          </div>
        </div>
      </header>

      <!-- MAIN TOKENIZER APP -->
      <section class="flex-1" aria-label="Tokenizer workspace">
        <TokenizerApp client:idle />
      </section>

      <section
        class="bg-white border-2 border-brand-black shadow-hard p-6 md:p-8 flex flex-col gap-6"
      >
        <h2
          class="font-display text-2xl md:text-3xl font-bold uppercase leading-tight"
        >
          Tokenizer For GPT, O-Series, And Legacy Models
        </h2>
        <p
          class="font-body text-base md:text-lg text-brand-black leading-relaxed"
        >
          HappyTokenizer is a browser-based token analysis tool for developers,
          prompt engineers, and AI product teams. Use it to inspect token
          boundaries, compare model encodings, and estimate API spend before you
          ship prompts to production.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <article class="border border-brand-black p-4">
            <h3
              class="font-mono text-xs uppercase tracking-wider text-brand-orange mb-2"
            >
              Real-Time Analysis
            </h3>
            <p class="font-body text-sm text-brand-black">
              See exactly how text maps to tokens for each supported model in
              milliseconds.
            </p>
          </article>
          <article class="border border-brand-black p-4">
            <h3
              class="font-mono text-xs uppercase tracking-wider text-brand-orange mb-2"
            >
              Cost Estimation
            </h3>
            <p class="font-body text-sm text-brand-black">
              Compare input, output, and cached pricing to forecast prompt
              economics more accurately.
            </p>
          </article>
          <article class="border border-brand-black p-4">
            <h3
              class="font-mono text-xs uppercase tracking-wider text-brand-orange mb-2"
            >
              Privacy-First
            </h3>
            <p class="font-body text-sm text-brand-black">
              Tokenization runs client-side, so your prompt text remains on your
              machine.
            </p>
          </article>
        </div>
        <p class="font-mono text-xs text-brand-steel">
          Explore more tools: <a
            href="/chat"
            class="text-brand-orange hover:underline"
            data-analytics-event="internal_navigation_clicked"
            data-analytics-category="navigation"
            data-analytics-label="chat_tokenizer"
            data-analytics-location="homepage_content">Chat Tokenizer</a
          > and <a
            href="/models"
            class="text-brand-orange hover:underline"
            data-analytics-event="internal_navigation_clicked"
            data-analytics-category="navigation"
            data-analytics-label="model_manifest"
            data-analytics-location="homepage_content">System Manifest</a
          >.
        </p>
      </section>

      <section
        class="bg-white border-2 border-brand-black shadow-hard p-6 md:p-8 flex flex-col gap-5"
      >
        <h2 class="font-display text-2xl md:text-3xl font-bold uppercase">
          Frequently Asked Questions
        </h2>
        <article class="flex flex-col gap-2">
          <h3 class="font-display text-xl font-bold">
            What is HappyTokenizer used for?
          </h3>
          <p class="font-body text-base leading-relaxed text-brand-black">
            HappyTokenizer helps developers analyze how text is split into
            tokens for different GPT and OpenAI model encodings, and estimate
            cost impact per model.
          </p>
        </article>
        <article class="flex flex-col gap-2">
          <h3 class="font-display text-xl font-bold">
            Does HappyTokenizer send my text to a server?
          </h3>
          <p class="font-body text-base leading-relaxed text-brand-black">
            No. Tokenization runs client-side in your browser, so your input
            stays local while you inspect token usage.
          </p>
        </article>
        <article class="flex flex-col gap-2">
          <h3 class="font-display text-xl font-bold">
            Can I compare multiple model families?
          </h3>
          <p class="font-body text-base leading-relaxed text-brand-black">
            Yes. You can switch between modern GPT models, chat models, code
            models, and legacy model families to compare token counts and
            pricing behavior.
          </p>
        </article>
      </section>

      <!-- ABOUT -->
      <section
        id="about"
        class="relative overflow-hidden bg-white border-2 border-brand-black shadow-hard p-6 md:p-8 flex flex-col gap-6"
      >
        <div
          class="absolute top-0 left-0 w-full h-1 bg-linear-to-r from-(--c-orange) to-(--c-black)"
        >
        </div>

        <div
          class="font-mono text-xs uppercase tracking-wider text-(--c-orange) font-bold"
        >
          // About
        </div>

        <h2
          class="font-display text-3xl md:text-4xl font-black uppercase leading-[0.9] tracking-tight"
        >
          Built By One Developer
        </h2>

        <p
          class="font-body text-base md:text-lg leading-relaxed text-gray-800 max-w-3xl border-l-4 border-(--c-orange) pl-5"
        >
          HappyTokenizer is a side project by <strong>Kamran Tahir</strong>.
          It runs entirely in your browser — no account, no uploads, no
          tracking. Paste your text, get your numbers.
        </p>

        <div class="grid grid-cols-3 gap-px bg-black border border-black max-w-md">
          <div class="bg-white p-3">
            <div class="font-display text-xl font-black">140+</div>
            <div class="font-mono text-[10px] uppercase text-gray-500">
              Models
            </div>
          </div>
          <div class="bg-white p-3">
            <div class="font-display text-xl font-black">5</div>
            <div class="font-mono text-[10px] uppercase text-gray-500">
              Vendors
            </div>
          </div>
          <div class="bg-white p-3">
            <div class="font-display text-xl font-black">0</div>
            <div class="font-mono text-[10px] uppercase text-gray-500">
              Signups
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="https://kamran.sh"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex flex-col border-2 border-brand-black bg-(--c-paper) px-5 py-3 no-underline transition-all duration-200 hover:bg-(--c-orange) hover:text-white hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_var(--c-black)]"
          >
            <span class="font-display text-sm font-bold uppercase leading-none">
              See My Work
            </span>
            <span
              class="font-mono text-[10px] uppercase mt-1 text-gray-500 group-hover:text-white/80"
            >
              kamran.sh
            </span>
          </a>
          <a
            href="https://saybackend.com"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex flex-col border-2 border-brand-black bg-(--c-paper) px-5 py-3 no-underline transition-all duration-200 hover:bg-(--c-orange) hover:text-white hover:-translate-y-0.5 hover:shadow-[4px_4px_0px_var(--c-black)]"
          >
            <span class="font-display text-sm font-bold uppercase leading-none">
              Read The Blog
            </span>
            <span
              class="font-mono text-[10px] uppercase mt-1 text-gray-500 group-hover:text-white/80"
            >
              saybackend.com
            </span>
          </a>
        </div>
      </section>
    </div>
  </div>
</MainLayout>
