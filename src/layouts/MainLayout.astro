---
import FontLoader from "../components/FontLoader.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface SchemaNode {
  [key: string]: unknown;
}

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  keywords?: string;
  noindex?: boolean;
  schema?: SchemaNode | SchemaNode[];
}

const SITE_URL = "https://happytokenizer.com";
const GA_TRACKING_ID = "G-F1P9ZDDK7J";

const {
  title,
  description,
  image = "/og-image.png",
  canonicalUrl,
  keywords = "tokenizer, llm tokenizer, gpt tokenizer, token counter, openai token calculator, ai tokenization",
  noindex = false,
  schema,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? SITE_URL;
const resolvedCanonicalUrl =
  canonicalUrl ?? new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const ogImageUrl = image.startsWith("http")
  ? image
  : new URL(image, `${siteUrl}/`).toString();
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const defaultSchemaGraph: SchemaNode[] = [
  {
    "@type": "Organization",
    name: "HappyTokenizer",
    url: siteUrl,
    logo: new URL("/logo.svg", `${siteUrl}/`).toString(),
    sameAs: [
      "https://github.com/happytoolin/happytokenizer",
      "https://x.com/happytokenizer",
    ],
  },
  {
    "@type": "WebSite",
    name: "HappyTokenizer",
    url: siteUrl,
    inLanguage: "en-US",
  },
  {
    "@type": "WebPage",
    name: title,
    description,
    url: resolvedCanonicalUrl,
    inLanguage: "en-US",
    isPartOf: {
      "@type": "WebSite",
      url: siteUrl,
    },
    primaryImageOfPage: ogImageUrl,
  },
];

const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...defaultSchemaGraph, ...pageSchema],
};

const partytownGtagBootstrap = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;
gtag('js', new Date());
gtag('config', '${GA_TRACKING_ID}', {
  send_page_view: true,
  anonymize_ip: false,
  allow_google_signals: true,
  page_title: document.title,
  page_location: window.location.href
});
`;

const analyticsRuntime = `
window.dataLayer = window.dataLayer || [];
window.gtag = window.gtag || function(){window.dataLayer.push(arguments);};
window.trackEvent = function(eventName, params) {
  if (!eventName || typeof eventName !== 'string') return;
  var payload = params && typeof params === 'object' ? params : {};
  window.gtag('event', eventName, payload);
};

document.addEventListener('click', function(event) {
  var target = event.target;
  if (!(target instanceof Element)) return;

  var trackedElement = target.closest('[data-analytics-event]');
  if (trackedElement) {
    var analyticsEvent = trackedElement.getAttribute('data-analytics-event');
    if (analyticsEvent) {
      var analyticsPayload = {
        event_category: trackedElement.getAttribute('data-analytics-category') || 'engagement',
        event_label: trackedElement.getAttribute('data-analytics-label') || (trackedElement.textContent || '').trim().slice(0, 80) || 'unknown',
        link_location: trackedElement.getAttribute('data-analytics-location') || window.location.pathname,
      };
      window.trackEvent(analyticsEvent, analyticsPayload);
    }
  }

  var anchor = target.closest('a[href]');
  if (!anchor) return;

  var href = anchor.getAttribute('href');
  if (!href || href.startsWith('#') || href.startsWith('/') || href.startsWith('mailto:') || href.startsWith('tel:')) {
    return;
  }

  try {
    var url = new URL(href, window.location.origin);
    if (url.host !== window.location.host) {
      window.trackEvent('outbound_link_clicked', {
        event_category: 'outbound',
        event_label: (anchor.textContent || '').trim().slice(0, 80) || url.host,
        link_url: url.href,
        link_host: url.host,
      });
    }
  } catch {
    // Ignore malformed URLs
  }
}, { capture: true });
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="HappyTokenizer" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />

    <link rel="canonical" href={resolvedCanonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HappyTokenizer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} preview`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@happytokenizer" />
    <meta name="twitter:url" content={resolvedCanonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} preview`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF6600" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      as="style"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="//www.googletagmanager.com" />

    <FontLoader />

    <title>{title}</title>

    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}
      type="text/partytown"></script>
    <script is:inline type="text/partytown" set:html={partytownGtagBootstrap} />
    <script is:inline set:html={analyticsRuntime} />
  </head>
  <body class="min-h-screen">
    <div class="min-h-screen">
      <main>
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
